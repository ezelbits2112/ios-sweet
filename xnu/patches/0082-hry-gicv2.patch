diff --git a/osfmk/arm64/sleh.c b/osfmk/arm64/sleh.c
index 24f1abc..182eb5b 100644
--- a/osfmk/arm64/sleh.c
+++ b/osfmk/arm64/sleh.c
@@ -1856,12 +1856,17 @@ sleh_irq(arm_saved_state_t *state)
 #endif
 
 
-#if defined(SWEET)
+#if defined(HRY) || defined(SWEET)
+#if defined(HRY)
+	/* Kirin's GIC-400 has a memory-mapped CPU interface (no ICC_* sysregs). */
+	uint32_t iar = hry_gic_iar();
+#else
 	/*
 	 * sweet: TrustZone owns GIC Group 0, so the timer and IPIs that other
 	 * ARM64 targets take as FIQs arrive here as Group 1 IRQs.
 	 */
 	uint64_t iar = __builtin_arm_rsr64("ICC_IAR1_EL1");
+#endif
 	uint32_t intid = (uint32_t)(iar & 0xFFFFFF);
 
 	if (intid >= 1020 && intid <= 1023) {
@@ -1873,11 +1878,19 @@ sleh_irq(arm_saved_state_t *state)
 		INTERRUPT_MASKED_DEBUG_START(rtclock_intr, DBG_INTR_TYPE_TIMER);
 		rtclock_intr(TRUE);
 		INTERRUPT_MASKED_DEBUG_END();
+#if defined(HRY)
+		hry_gic_eoi(iar);
+#else
 		__builtin_arm_wsr64("ICC_EOIR1_EL1", iar);
+#endif
 	} else if (intid < 16) {
 		sleh_interrupt_handler_prologue(state, DBG_INTR_TYPE_IPI);
 		/* Ack before handling so an IPI raised meanwhile is not lost */
+#if defined(HRY)
+		hry_gic_eoi(iar);
+#else
 		__builtin_arm_wsr64("ICC_EOIR1_EL1", iar);
+#endif
 		__builtin_arm_isb(ISB_SY);
 		cpu_signal_handler();
 	} else {
@@ -1888,7 +1901,11 @@ sleh_irq(arm_saved_state_t *state)
 			    cdp->interrupt_nub,
 			    intid);
 		}
+#if defined(HRY)
+		hry_gic_eoi(iar);
+#else
 		__builtin_arm_wsr64("ICC_EOIR1_EL1", iar);
+#endif
 	}
 	__builtin_arm_isb(ISB_SY);
 #else
@@ -1903,7 +1920,7 @@ sleh_irq(arm_saved_state_t *state)
 	    cdp->interrupt_nub,
 	    cdp->interrupt_source);
 #endif
-#endif /* SWEET */
+#endif /* HRY || SWEET */
 
 	entropy_collect();
 

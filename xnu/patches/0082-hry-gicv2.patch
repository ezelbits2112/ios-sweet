diff --git a/pexpert/pexpert/arm64/SWEET.h b/pexpert/pexpert/arm64/SWEET.h
index b99c2f4..9f60a6b 100644
--- a/pexpert/pexpert/arm64/SWEET.h
+++ b/pexpert/pexpert/arm64/SWEET.h
@@ -17,6 +17,10 @@
 
 #define SWEET                     1
 
+#if defined(ARM64_BOARD_CONFIG_HRY)
+#define HRY                       1
+#endif
+
 /*
  * All eight cores (six A55 + two A76) as one homogeneous SMP cluster:
  * cpus=N is clamped here. Same ISA level (ARMv8.2), 64-byte lines, PSCI
@@ -36,7 +40,12 @@
 #define __ARM_PAN_AVAILABLE__     1
 #define __ARM_16K_PG__            1
 
+#if defined(HRY)
+/* Kirin 710 has an ARM GIC-400: GICD + GICC, no redistributors. */
+#define HAS_GIC_V2                1
+#else
 #define HAS_GIC_V3                1
+#endif
 
 #ifndef ASSEMBLER
 #define PLATFORM_PANIC_LOG_DISABLED
@@ -80,4 +89,17 @@
 #define ICC_SRE_SRE                             0x1
 /* End of GICv3 register definitions */
 
+/* GICv2 (GIC-400): memory-mapped CPU interface, no ICC_* system registers. */
+#define GICD_IGROUPR0                           0x080
+#define GICD_ISENABLER0                         0x100
+#define GICD_IPRIORITYR0                        0x400
+#define GICD_CTLR_ENABLEGRP1_V2                 0x1
+
+#define GICC_CTLR                               0x000
+#define GICC_PMR                                0x004
+#define GICC_BPR                                0x008
+#define GICC_IAR                                0x00c
+#define GICC_EOIR                               0x010
+#define GICC_CTLR_ENABLEGRP1                    0x1
+
 #endif /* ! _PEXPERT_ARM64_SWEET_H */
diff --git a/pexpert/pexpert/arm64/board_config.h b/pexpert/pexpert/arm64/board_config.h
index 88e524a..d900017 100644
--- a/pexpert/pexpert/arm64/board_config.h
+++ b/pexpert/pexpert/arm64/board_config.h
@@ -108,6 +108,22 @@
 
 #endif  /* ARM64_BOARD_CONFIG_SWEET */
 
+#ifdef ARM64_BOARD_CONFIG_HRY
+/*
+ * Honor 10 Lite / Hi3670: 4x Cortex-A53 + 4x Cortex-A73, GIC-400 (GICv2).
+ * The hardware-agnostic SWEET work is reused; only the interrupt controller
+ * and ISA level differ.
+ */
+#include <pexpert/arm64/SWEET.h>
+
